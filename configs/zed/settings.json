// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "unnecessary_code_fade": 0.5,
  "diff_view_style": "unified",
  "cli_default_open_behavior": "new_window",
  "multi_cursor_modifier": "cmd_or_ctrl",
  "ensure_final_newline_on_save": false,
  "git": {
    "branch_picker": {
      "show_author_name": false
    },
    "blame": {
      "show_avatar": false
    },
    "enable_diff": false,
    "enable_status": true,
    "inline_blame": {
      "enabled": false,
    },
  },
  "auto_update": false,
  "soft_wrap": "editor_width",
  "buffer_font_family": "DejaVu Sans Mono",
  "buffer_line_height": "standard",
  "toolbar": {
    "selections_menu": true,
    "quick_actions": false,
    "breadcrumbs": true,
  },
  "buffer_font_weight": 500.0,
  "project_panel": {
    "dock": "left",
    "file_icons": false,
    "auto_reveal_entries": false,
  },
  "disable_ai": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "base_keymap": "SublimeText",
  "icon_theme": "Zed (Default)",
  "ui_font_size": 13.0,
  "buffer_font_size": 14.0,
  "theme": "One Dark",
  "theme_overrides": {
    "One Dark": {
      "text.muted": "#DDD",
      "background": "#000",
      "editor.background": "#000",
      "editor.foreground": "#FFF",
      "tab_bar.background": "#000",
      "terminal.background": "#000",
      "terminal.foreground": "#DDD",
      "syntax": {
        "string": {
          "color": "#61CE3CFF",
        },
        "string.escape": {
          "color": "#61CE3CFF",
        },
        "string.regex": {
          "color": "#61CE3CFF",
        },
        "string.special": {
          "color": "#61CE3CFF",
        },
        "text.literal": {
          "color": "#61CE3CFF",
        },

        "type": {
          "color": "#8DA6CEFF",
        },
        "constant": {
          "color": "#8DA6CEFF",
        },
        "enum": {
          "color": "#8DA6CEFF",
        },
        "namespace": {
          "color": "#8DA6CEFF",
        },
        "variant": {
          "color": "#8DA6CEFF",
        },
        "tag": {
          "color": "#8DA6CEFF",
        },

        "variable": {
          "color": "#DDD",
        },
        "property": {
          "color": "#DDD",
        },
        "attribute": {
          "color": "#DDD",
        },
        "variable.special": {
          "color": "#DDD",
        },
        "label": {
          "color": "#DDD",
        },
        "punctuation": {
          "color": "#DDD",
        },
        "punctuation.bracket": {
          "color": "#DDD",
        },
        "punctuation.delimiter": {
          "color": "#DDD",
        },
        "punctuation.list_marker": {
          "color": "#DDD",
        },
        "punctuation.markup": {
          "color": "#DDD",
        },
        "punctuation.special": {
          "color": "#DDD",
        },
        "primary": {
          "color": "#DDD",
        },
        "embedded": {
          "color": "#DDD",
        },
        "predictive": {
          "color": "#DDD",
        },
        "hint": {
          "color": "#DDD",
        },
        "variable.parameter": {
          "color": "#DDD"
        },

        "number": {
          "color": "#D8FA3CFF",
        },
        "boolean": {
          "color": "#D8FA3CFF",
        },
        "string.special.symbol": {
          "color": "#D8FA3CFF",
        },

        "keyword": {
          "color": "#FBDE2DFF",
        },
        "operator": {
          "color": "#FBDE2DFF",
        },
        "preproc": {
          "color": "#FBDE2DFF",
        },
        "title": {
          "color": "#FBDE2DFF",
        },
        "emphasis": {
          "color": "#FBDE2DFF",
        },
        "emphasis.strong": {
          "color": "#FBDE2DFF",
        },
        "link_text": {
          "color": "#FBDE2DFF",
        },
        "link_uri": {
          "color": "#FBDE2DFF",
        },
        "selector": {
          "color": "#FBDE2DFF",
        },
        "selector.pseudo": {
          "color": "#FBDE2DFF",
        },

        "function": {
          "color": "#ffa061FF",
        },
      },
    },
  },
  "lsp": {
    "solargraph": {
      "settings": {
        "use_bundler": false
      }
    }
  },
  "languages": {
    "Shell Script": {
      "tab_size": 2,
      "hard_tabs": false
    }
  }
}
